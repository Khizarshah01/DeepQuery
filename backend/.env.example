# Local Postgres from docker-compose.yml (no extra Postgres key needed)
DATABASE_URL="postgresql://deepquery:deepquery@127.0.0.1:5462/deepquery"

# Local Redis from docker-compose.yml (no extra Redis key needed)
REDIS_URL="redis://127.0.0.1:6382"

# Required: create a project at https://supabase.com
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Use the service_role secret from Project Settings → API
SECRET_KEY_BASE="your-supabase-service-role-key"

# Required: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Required: https://app.tavily.com/home
TAVILY_API_KEY="your-tavily-api-key"
